<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:Herdview.Modelo">

    <!-- Una cabina de noche: fondo casi negro, texto cálido y cada sesión es una luz del tablero. -->
    <Color x:Key="ColFondo">#16181C</Color>
    <Color x:Key="ColSuperficie">#1F2228</Color>
    <Color x:Key="ColSuperficieAlta">#292D35</Color>
    <Color x:Key="ColBorde">#2C2F36</Color>
    <Color x:Key="ColTexto">#E8E6E1</Color>
    <Color x:Key="ColTenue">#8A8F98</Color>
    <Color x:Key="ColApagada">#5A606B</Color>
    <Color x:Key="ColTrabajando">#6FA8FF</Color>
    <Color x:Key="ColEsperando">#F2B53A</Color>
    <Color x:Key="ColTerminado">#5FD38A</Color>

    <SolidColorBrush x:Key="BrFondo" Color="{StaticResource ColFondo}" />
    <SolidColorBrush x:Key="BrFondoTira" Color="#EE16181C" />
    <SolidColorBrush x:Key="BrSuperficie" Color="{StaticResource ColSuperficie}" />
    <SolidColorBrush x:Key="BrSuperficieAlta" Color="{StaticResource ColSuperficieAlta}" />
    <SolidColorBrush x:Key="BrBorde" Color="{StaticResource ColBorde}" />
    <SolidColorBrush x:Key="BrTexto" Color="{StaticResource ColTexto}" />
    <SolidColorBrush x:Key="BrTenue" Color="{StaticResource ColTenue}" />
    <SolidColorBrush x:Key="BrApagada" Color="{StaticResource ColApagada}" />
    <SolidColorBrush x:Key="BrTrabajando" Color="{StaticResource ColTrabajando}" />
    <SolidColorBrush x:Key="BrEsperando" Color="{StaticResource ColEsperando}" />
    <SolidColorBrush x:Key="BrTerminado" Color="{StaticResource ColTerminado}" />
    <SolidColorBrush x:Key="BrEsperandoFondo" Color="#33F2B53A" />

    <FontFamily x:Key="FuenteUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FuenteMono">Cascadia Mono, Consolas</FontFamily>

    <!-- La luz de estado: color por estado; la de «te espera» late. -->
    <Style x:Key="Luz" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Fill" Value="{StaticResource BrApagada}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="7" Opacity="0.75" Color="{StaticResource ColApagada}" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoSesion.Trabajando}">
                <Setter Property="Fill" Value="{StaticResource BrTrabajando}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.9" Color="{StaticResource ColTrabajando}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoSesion.Terminado}">
                <Setter Property="Fill" Value="{StaticResource BrTerminado}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.9" Color="{StaticResource ColTerminado}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoSesion.Esperando}">
                <Setter Property="Fill" Value="{StaticResource BrEsperando}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="1" Color="{StaticResource ColEsperando}" />
                    </Setter.Value>
                </Setter>
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Latido">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.7" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Latido" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Texto del estado con el color de su luz. -->
    <Style x:Key="TextoEstado" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrTenue}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoSesion.Trabajando}">
                <Setter Property="Foreground" Value="{StaticResource BrTrabajando}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoSesion.Esperando}">
                <Setter Property="Foreground" Value="{StaticResource BrEsperando}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Estado}" Value="{x:Static m:EstadoSesion.Terminado}">
                <Setter Property="Foreground" Value="{StaticResource BrTerminado}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Botón plano que solo enseña su contenido (las fichas de la tira y las filas del panel). -->
    <Style x:Key="BotonPlano" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource BrTexto}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BrSuperficieAlta}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Caja" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource BrTexto}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrTexto}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrTrabajando}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxHeight" Value="110" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Marco" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BrBorde}"
                            BorderThickness="1" CornerRadius="4" Padding="6,4">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource BrTrabajando}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opción como pastilla (las cuentas): marcada, con el borde y el texto en azul. -->
    <Style x:Key="Pastilla" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrTenue}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Marco" Background="{StaticResource BrSuperficie}" BorderBrush="{StaticResource BrBorde}"
                            BorderThickness="1" CornerRadius="4" Padding="12,5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource BrTrabajando}" />
                            <Setter Property="Foreground" Value="{StaticResource BrTexto}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Marco" Property="Background" Value="{StaticResource BrSuperficieAlta}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- La acción principal de un diálogo. -->
    <Style x:Key="BotonPrincipal" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#0E1116" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{StaticResource BrTrabajando}" CornerRadius="4" Padding="16,7">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#8DBBFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolTipOscuro" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource BrSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource BrTexto}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrBorde}" />
        <Setter Property="FontFamily" Value="{StaticResource FuenteUi}" />
        <Setter Property="MaxWidth" Value="380" />
    </Style>
</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Herdview</AssemblyName>
    <RootNamespace>Herdview</RootNamespace>
    <ApplicationIcon>icono.ico</ApplicationIcon>
    <!-- La release la sobrescribe con el tag (compilar.ps1 -Version). -->
    <Version>0.1.0</Version>
    <Product>Herdview</Product>
    <Description>Todas las sesiones de Claude Code del PC de un vistazo</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>

<Window x:Class="Herdview.VentanaPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Herdview" Width="440" SizeToContent="Height" MaxHeight="640" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="{StaticResource BrFondo}" FontFamily="{StaticResource FuenteUi}"
        Foreground="{StaticResource BrTexto}" BorderBrush="{StaticResource BrBorde}" BorderThickness="1">
    <DockPanel>
        <!-- Cabecera: nombre y recuento, como el rótulo de un tablero. -->
        <Border DockPanel.Dock="Top" Padding="16,12,10,10" BorderBrush="{StaticResource BrBorde}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BotonPlano}" Click="AlCerrar" ToolTip="Ocultar">
                    <TextBlock Text="✕" Foreground="{StaticResource BrTenue}" FontSize="12" Margin="8,3" />
                </Button>
                <StackPanel>
                    <TextBlock Text="HERDVIEW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrTenue}" />
                    <TextBlock x:Name="Resumen" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pie: interruptores. -->
        <Border DockPanel.Dock="Bottom" Padding="10,6" BorderBrush="{StaticResource BrBorde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BotonPlano}" Click="AlSalir">
                    <TextBlock Text="Salir" Foreground="{StaticResource BrTenue}" FontSize="12" Margin="8,4" />
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BotonPlano}" Click="AlNuevaSesion" ToolTip="Abrir Claude en una carpeta">
                        <TextBlock Text="+ Nueva" Foreground="{StaticResource BrTrabajando}" FontSize="12" Margin="8,4" />
                    </Button>
                    <Button Style="{StaticResource BotonPlano}" Click="AlAbrirVentana" ToolTip="Todas las sesiones con su consumo de tokens">
                        <TextBlock Text="Ventana" Foreground="{StaticResource BrTexto}" FontSize="12" Margin="8,4" />
                    </Button>
                    <Button Style="{StaticResource BotonPlano}" Click="AlCambiarTira">
                        <TextBlock x:Name="TextoTira" Foreground="{StaticResource BrTenue}" FontSize="12" Margin="8,4" />
                    </Button>
                    <Button Style="{StaticResource BotonPlano}" Click="AlCambiarArranque">
                        <TextBlock x:Name="TextoArranque" Foreground="{StaticResource BrTenue}" FontSize="12" Margin="8,4" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <TextBlock x:Name="Vacio" Text="No hay sesiones de Claude abiertas." Foreground="{StaticResource BrTenue}"
                       Margin="16,22" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Lista" Margin="6,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1,0,4">
                            <Button Style="{StaticResource BotonPlano}" Command="{Binding Enfocar}"
                                    HorizontalContentAlignment="Stretch" ToolTip="Traer su ventana al frente">
                                <Grid Margin="10,9,10,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource Luz}" VerticalAlignment="Top" Margin="0,5,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Proyecto, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                            <Run Text="{Binding Origen, Mode=OneWay}" FontSize="11" Foreground="{StaticResource BrApagada}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Linea}" FontSize="12.5" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrTexto}" />
                                        <TextBlock x:Name="Pedido" Text="{Binding Pedido, StringFormat='» {0}'}" FontSize="11.5"
                                                   Margin="0,3,0,0" Foreground="{StaticResource BrTenue}" TextWrapping="Wrap"
                                                   MaxHeight="32" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding NombreEstado}" Style="{StaticResource TextoEstado}" FontSize="11.5"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Tiempo}" FontFamily="{StaticResource FuenteMono}" FontSize="12"
                                                   Foreground="{StaticResource BrTenue}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <!-- Escribirle sin cambiar de ventana: lo recoge el hook de la sesión y la despierta. -->
                            <DockPanel Margin="31,0,10,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BotonPlano}" Command="{Binding Cerrar}"
                                    VerticalAlignment="Top" Margin="6,0,0,0" ToolTip="Cerrar esta sesión de Claude">
                                <TextBlock Text="Cerrar" Foreground="{StaticResource BrApagada}" FontSize="11.5" Margin="8,6" />
                            </Button>
                            <Grid x:Name="Escribir">
                                <TextBox x:Name="Caja" Style="{StaticResource Caja}" PreviewKeyDown="AlTeclearCaja" />
                                <TextBlock x:Name="Pista" Text="Escríbele…  (Enter envía · Mayús+Enter, salto de línea)"
                                           Foreground="{StaticResource BrApagada}" FontSize="12" Margin="9,5,0,0"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                            </DockPanel>
                            <TextBlock x:Name="Nota" Text="{Binding Nota}" FontSize="11" Margin="32,3,10,0"
                                       Foreground="{StaticResource BrTerminado}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding TienePedido}" Value="False">
                                    <Setter TargetName="Pedido" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PuedeEscribir}" Value="False">
                                    <Setter TargetName="Escribir" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Nota}" Value="">
                                    <Setter TargetName="Nota" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=Caja}" Value="">
                                    <Setter TargetName="Pista" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="Herdview.VentanaNueva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Herdview"
        Title="Nueva sesión de Claude" Width="580" SizeToContent="Height" ResizeMode="NoResize" Topmost="True"
        Background="{StaticResource BrFondo}" Foreground="{StaticResource BrTexto}" FontFamily="{StaticResource FuenteUi}"
        Icon="icono.ico" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="NUEVA SESIÓN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrTenue}" />
        <TextBlock Text="¿Dónde la abro?" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,14" />

        <WrapPanel Margin="0,0,0,16">
            <RadioButton x:Name="EnWindows" Style="{StaticResource Pastilla}" GroupName="Donde" IsChecked="True"
                         Checked="AlCambiarDonde">
                <TextBlock Text="Windows" FontSize="12.5" />
            </RadioButton>
            <RadioButton x:Name="EnContenedor" Style="{StaticResource Pastilla}" GroupName="Donde" Checked="AlCambiarDonde">
                <TextBlock Text="Contenedor de Docker" FontSize="12.5" />
            </RadioButton>
        </WrapPanel>

        <!-- Docker: un contenedor en marcha y, si se quiere, la carpeta de dentro donde arrancar. -->
        <StackPanel x:Name="PanelDocker" Visibility="Collapsed">
            <TextBlock Text="CONTENEDOR" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrApagada}" Margin="0,0,0,6" />
            <TextBlock x:Name="EstadoDocker" FontSize="12" Foreground="{StaticResource BrTenue}" Margin="0,0,0,6" />
            <WrapPanel x:Name="Contenedores" />
            <TextBlock Text="CARPETA DENTRO DEL CONTENEDOR (OPCIONAL)" FontSize="10.5" FontWeight="Bold"
                       Foreground="{StaticResource BrApagada}" Margin="0,16,0,5" />
            <TextBox x:Name="CarpetaDocker" Style="{StaticResource Caja}" AcceptsReturn="False" TextWrapping="NoWrap"
                     PreviewKeyDown="AlTeclear" ToolTip="Vacío: la carpeta de trabajo del contenedor (WORKDIR)" />
            <TextBlock Text="La primera vez Herdview copia su hook en el contenedor (necesita python3) para verla y escribirle."
                       FontSize="11" Foreground="{StaticResource BrApagada}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="PanelWindows">
        <TextBlock Text="CARPETA" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrApagada}" Margin="0,0,0,5" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BotonPlano}" Click="AlElegir" Margin="8,0,0,0">
                <TextBlock Text="Elegir…" FontSize="12.5" Margin="10,6" />
            </Button>
            <TextBox x:Name="Carpeta" Style="{StaticResource Caja}" AcceptsReturn="False" TextWrapping="NoWrap"
                     PreviewKeyDown="AlTeclear" />
        </DockPanel>
        <TextBlock x:Name="Error" Foreground="#E0605A" FontSize="11.5" Margin="0,4,0,0" Visibility="Collapsed" />

        <!-- Recientes: un clic y listo. -->
        <ItemsControl x:Name="Recientes" Margin="-6,8,-6,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource BotonPlano}" Click="AlElegirReciente" Tag="{Binding}"
                            HorizontalContentAlignment="Stretch">
                        <DockPanel Margin="6,5">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Converter={x:Static local:NombreCarpeta.Uno}}"
                                       FontSize="12.5" FontWeight="SemiBold" Width="150" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource BrApagada}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="CUENTA" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrApagada}" Margin="0,16,0,6" />
        <WrapPanel x:Name="Cuentas" />
        </StackPanel>

        <TextBlock Text="PRIMER PEDIDO (OPCIONAL)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource BrApagada}"
                   Margin="0,16,0,5" />
        <Grid>
            <TextBox x:Name="Pedido" Style="{StaticResource Caja}" MinHeight="64" PreviewKeyDown="AlTeclear" />
            <TextBlock x:Name="PistaPedido" Text="Lo primero que le pides (Ctrl+Enter abre)" Foreground="{StaticResource BrApagada}"
                       FontSize="12" Margin="9,5,0,0" IsHitTestVisible="False" />
        </Grid>

        <DockPanel Margin="0,20,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource BotonPrincipal}" Click="AlAbrir"
                    Content="Abrir en Windows Terminal" />
            <Button DockPanel.Dock="Right" Style="{StaticResource BotonPlano}" Click="AlCancelar" Margin="0,0,8,0">
                <TextBlock Text="Cancelar" Foreground="{StaticResource BrTenue}" FontSize="12.5" Margin="12,7" />
            </Button>
            <TextBlock />
        </DockPanel>
    </StackPanel>
</Window>

<Window x:Class="Cabina.VentanaTira"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cabina" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource FuenteUi}">
    <Border Background="{StaticResource BrFondoTira}" BorderBrush="{StaticResource BrBorde}" BorderThickness="1"
            CornerRadius="6" Padding="3">
        <StackPanel Orientation="Horizontal">
            <!-- Asa: arrastrar mueve la tira; clic abre el panel. -->
            <Border x:Name="Asa" Width="14" Margin="1,0,3,0" Background="Transparent" Cursor="SizeAll"
                    ToolTip="Arrastra para mover · clic para abrir el panel">
                <TextBlock Text="⋮" Foreground="{StaticResource BrApagada}" FontSize="14" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Vacia" Text="sin sesiones" Foreground="{StaticResource BrApagada}" FontSize="12"
                       VerticalAlignment="Center" Margin="4,4,10,4" Visibility="Collapsed" />
            <ItemsControl x:Name="Fichas">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource BotonPlano}" Command="{Binding Enfocar}" Margin="1,0">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource ToolTipOscuro}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Proyecto, Mode=OneWay}" />
                                            <Run Text="·" Foreground="{StaticResource BrTenue}" />
                                            <Run Text="{Binding NombreEstado, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detalle}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Foreground="{StaticResource BrTenue}" />
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                            <Border x:Name="Ficha" Padding="8,4,9,4" CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Luz}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Proyecto}" Foreground="{StaticResource BrTexto}" FontSize="12.5"
                                               FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Tiempo}" Foreground="{StaticResource BrTenue}" FontSize="11.5"
                                               FontFamily="{StaticResource FuenteMono}" Margin="7,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Estado}" Value="Esperando">
                                <Setter TargetName="Ficha" Property="Background" Value="{StaticResource BrEsperandoFondo}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
